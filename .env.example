# Copy to `.env` (`cp .env.example .env`) and adjust the values, e.g. the credentials.
# docker-compose.yml reads `.env`; this template file is never read directly.
POSTGRES_USER=recipe
POSTGRES_PASSWORD=recipe
POSTGRES_DB=recipe_planner

# Host port the database is published on (container-internal port stays 5432).
# 5433 avoids clashing with a PostgreSQL server installed on the host.
POSTGRES_PORT=5433

# Origins allowed by the backend's CORS middleware (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL the *browser* uses to reach the backend (baked into the frontend by Vite).
VITE_API_URL=http://localhost:8000

# --- LLM (Ollama) ---------------------------------------------------------------------
# Host port of the Ollama container. Change it if Ollama already runs natively on the host.
OLLAMA_PORT=11434
# Where the backend container reaches Ollama. To use an Ollama installed on the host
# instead of the container, set http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
# Changing the embedding model requires matching EMBEDDING_DIM, recreating the
# `recipe_chunks` table (`make reset`) and re-seeding.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Copy to `.env` (`cp .env.example .env`); Docker Compose and the backend both read it.
POSTGRES_USER=recipe
POSTGRES_PASSWORD=recipe
POSTGRES_DB=recipe_planner
# Host port of the database (5433 avoids clashing with a local PostgreSQL).
POSTGRES_PORT=5433

# Origins allowed by the backend's CORS middleware (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# URL the *browser* uses to reach the backend (baked into the frontend at build time).
VITE_API_URL=http://localhost:8000

# LLM and embeddings run in the local Ollama app (http://localhost:11434).
LLM_MODEL=qwen3.5:4b
# Reasoning mode; slow on CPU.
LLM_THINK=false
EMBEDDING_MODEL=nomic-embed-text
# Must match the embedding model's output size; changing it needs `make reset` + `make seed`.
EMBEDDING_DIM=768

# Fridge suggestions: recipes the LLM ranks, and how many days count as "expiring soon".
FRIDGE_LLM_CANDIDATES=6
FRIDGE_EXPIRING_DAYS=3

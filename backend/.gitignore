# Virtual environment (managed by uv)
.venv/

# Bytecode
__pycache__/
*.py[cod]

# Tool caches (pytest, ruff and mypy write to .artifacts/, see pyproject.toml)
.artifacts/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test / coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# Build artifacts
build/
dist/
*.egg-info/

# Local SQLite databases
*.db
*.sqlite3
